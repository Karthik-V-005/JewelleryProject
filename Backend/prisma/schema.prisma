generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model kyc_documents {
  id         Int       @id @default(autoincrement())
  vendor_id  Int?
  doc_type   String    @db.VarChar(50)
  file_url   String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  vendors    vendors?  @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model offers {
  id                     Int       @id @default(autoincrement())
  vendor_id              Int?
  title                  String    @db.VarChar(255)
  description            String?
  poster_url             String?
  video_url              String?
  category               String?   @db.VarChar(100)
  start_date             DateTime? @db.Date
  end_date               DateTime? @db.Date
  discount_type          String?   @db.VarChar(50)
  discount_label         String?   @db.VarChar(100)
  discount_value_numeric Decimal?  @db.Decimal
  buy_link               String?
  status                 String?   @default("pending") @db.VarChar(20)
  like_count             Int?      @default(0)
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  shop_address           String?   @default("")
  map_link               String?
  is_featured            Boolean?  @default(false)
  rejection_reason       String?
  view_count             Int?          @default(0)
  offer_views            offer_views[]
  vendors                vendors?      @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model offer_views {
  offer_id   Int
  ip_address String   @db.VarChar(100)
  view_date  DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  offers     offers   @relation(fields: [offer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([offer_id, ip_address, view_date])
}

model products {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(255)
  description   String?
  images        String[]  @default([])
  affiliate_url String?
  status        String?   @default("active") @db.VarChar(20)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
}

model otp_verifications {
  id         Int       @id @default(autoincrement())
  email      String    @db.VarChar(255)
  otp        String    @db.VarChar(6)
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model subscriptions {
  id              Int       @id @default(autoincrement())
  vendor_id       Int?
  plan_name       String    @db.VarChar(50)
  price           Decimal   @db.Decimal(10, 2)
  total_posts     Int
  remaining_posts Int
  start_date      DateTime? @default(now()) @db.Timestamp(6)
  expiry_date     DateTime  @db.Timestamp(6)
  status          String?   @default("ACTIVE") @db.VarChar(20)
  vendors         vendors?  @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model vendors {
  id                     Int             @id @default(autoincrement())
  shop_name              String          @db.VarChar(255)
  owner_name             String?         @db.VarChar(255)
  email                  String?         @unique @db.VarChar(255)
  phone                  String?         @db.VarChar(20)
  state                  String?         @db.VarChar(100)
  city                   String?         @db.VarChar(100)
  country                String?         @db.VarChar(100)
  pincode                String?         @db.VarChar(10)
  address                String?
  status                 String?         @default("pending") @db.VarChar(20)
  created_at             DateTime?       @default(now()) @db.Timestamp(6)
  password_hash          String?         @default("")
  rejection_reason       String?
  reset_password_token   String?
  reset_password_expires DateTime?       @db.Timestamp(6)
  profile_picture_url    String?
  approved_at            DateTime?       @db.Timestamp(6)
  days_count             Int?            @default(0)
  reasons                String?
  kyc_documents          kyc_documents[]
  offers                 offers[]
  subscriptions          subscriptions[]
}

model Admins {
  id             String               @id @default(uuid())
  email          String               @unique
  password       String
  createdAt      DateTime             @default(now())
  passwordResets AdminPasswordReset[]
}

model AdminPasswordReset {
  id        String    @id @default(uuid())
  adminId   String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  admin     Admins    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

model plans {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(50)
  price      Int
  posts      Int
  months     Int
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
}

enum OfferStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  VENDOR_PENDING
  VENDOR_APPROVED
}

enum MediaStatus {
  PENDING
  APPROVED
  REJECTED
}

model Product {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(255)
  description   String?
  image1_url    String?
  image2_url    String?
  affiliate_url String
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
}

model StoreListing {
  id                Int                  @id @default(autoincrement())
  slug              String               @unique @db.VarChar(255)
  store_name        String               @db.VarChar(255)
  logo_url          String?
  cover_photo_url   String?
  short_description String?              @db.Text
  categories        String[]             @default([])
  address           String               @db.Text
  city              String               @db.VarChar(100)
  state             String               @db.VarChar(100)
  country           String               @default("India") @db.VarChar(100)
  pincode           String               @db.VarChar(10)
  google_maps_link  String?              @db.Text
  email             String?              @db.VarChar(255)
  emails            String[]             @default([])
  phone             String               @db.VarChar(25)
  phones            String[]             @default([])
  whatsapp          String?              @db.VarChar(25)
  website           String?              @db.VarChar(255)
  social_links      Json?
  opening_hours     String?              @db.VarChar(255)
  daywise_hours     Json?
  weekly_holiday    String?              @db.VarChar(100)
  weekly_holidays   String[]             @default([])
  status            String               @default("DRAFT") @db.VarChar(20)
  is_verified       Boolean              @default(false)
  info_source       String?              @db.VarChar(255)
  store_contact     String?              @db.VarChar(255)
  photo_permissions String?              @db.VarChar(100)
  internal_notes    String?              @db.Text
  created_at        DateTime             @default(now()) @db.Timestamp(6)
  updated_at        DateTime             @updatedAt @db.Timestamp(6)
  published_at      DateTime?            @db.Timestamp(6)
  gallery           StoreGallery[]
  offers            StoreOffer[]
  claim_requests    StoreClaimRequest[]
  report_requests   StoreReportRequest[]

  @@index([city, state])
  @@index([status])
  @@index([store_name])
}

model StoreGallery {
  id            Int          @id @default(autoincrement())
  store_id      Int
  image_url     String
  caption       String?      @db.VarChar(255)
  display_order Int          @default(0)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  store         StoreListing @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
}

model StoreOffer {
  id          Int          @id @default(autoincrement())
  store_id    Int
  title       String       @db.VarChar(255)
  description String?      @db.Text
  poster_url  String?
  start_date  DateTime?    @db.Date
  end_date    DateTime?    @db.Date
  terms       String?      @db.Text
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  updated_at  DateTime     @updatedAt @db.Timestamp(6)
  store       StoreListing @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, end_date])
}

model StoreClaimRequest {
  id             Int          @id @default(autoincrement())
  store_id       Int
  claimant_name  String       @db.VarChar(150)
  claimant_phone String       @db.VarChar(25)
  claimant_email String       @db.VarChar(150)
  proof_type     String?      @db.VarChar(100)
  proof_doc_url  String?
  notes          String?      @db.Text
  status         String       @default("PENDING") @db.VarChar(20)
  admin_notes    String?      @db.Text
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  store          StoreListing @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, status])
}

model StoreReportRequest {
  id                Int          @id @default(autoincrement())
  store_id          Int
  report_type       String       @db.VarChar(100)
  description       String       @db.Text
  reported_by_email String?      @db.VarChar(150)
  status            String       @default("PENDING") @db.VarChar(20)
  admin_notes       String?      @db.Text
  created_at        DateTime     @default(now()) @db.Timestamp(6)
  store             StoreListing @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, status])
}

